FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends slapd ldap-utils ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY slapd.conf /etc/ldap/slapd.conf
COPY seed.ldif /seed.ldif

RUN mkdir -p /var/lib/bauble-ldap \
 && slapadd -f /etc/ldap/slapd.conf -l /seed.ldif \
 && chown -R openldap:openldap /var/lib/bauble-ldap

EXPOSE 389

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
